# LLM 客户端配置（第四章起统一使用 LLM_* 这组变量，教程 4.1.3）
# 用法：复制本文件为 .env，填入真实密钥。.env 已被 .gitignore 忽略，不会提交。
LLM_API_KEY="sk-xxxx"
LLM_MODEL_ID="deepseek-chat"
LLM_BASE_URL="https://api.deepseek.com"
LLM_TIMEOUT="60"

# 搜索工具密钥（教程 4.2 起）
# 教程默认用 SerpApi（google-search-results），第一章案例用的是 Tavily，二选一即可
SERPAPI_API_KEY="your-serpapi-key"
TAVILY_API_KEY="tvly-xxxx"
